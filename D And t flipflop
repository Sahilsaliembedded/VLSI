module d_flipflop(
    input D, CLK, RESET,
    output reg Q
);
always @(posedge CLK or posedge RESET)
begin
    if(RESET)
        Q <= 1'b0;
    else
        Q <= D;
end
endmodule
module t_flipflop(
    input T, CLK, RESET,
    output reg Q
);
always @(posedge CLK or posedge RESET)
begin
    if(RESET)
        Q <= 1'b0;
    else if(T)
        Q <= ~Q;
    else
        Q <= Q;
end
endmodule

