module half_adder(
    input A,
    input B,
    output sum,
    output carry
);
assign sum = A ^ B;
assign carry = A & B;
endmodule
module full_adder(
    input A,
    input B,
    input cin,
    output sum,
    output cout
);
wire S1, C1, C2;
half_adder HA1(
    .A(A),
    .B(B),
    .sum(S1),
    .carry(C1)
);
half_adder HA2(
    .A(S1),
    .B(cin),
    .sum(sum),
    .carry(C2)
);
assign cout = C1 | C2;
endmodule

