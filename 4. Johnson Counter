module johnson_counter(
    input CLK,
    input RESET,
    output reg [3:0] Q
);

always @(posedge CLK or posedge RESET)
begin
    if(RESET)
        Q <= 4'b0000;
    else
        Q <= {Q[2:0], ~Q[3]};
end

endmodule

