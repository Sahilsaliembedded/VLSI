module updown_counter(
    input CLK,
    input RESET,
    input UPDOWN,
    output reg [2:0] Q
);
always @(posedge CLK)
begin
    if(!RESET)
        Q <= 3'b000;
    else if(UPDOWN)
        Q <= Q + 1'b1;
    else
        Q <= Q - 1'b1;
end
endmodule

