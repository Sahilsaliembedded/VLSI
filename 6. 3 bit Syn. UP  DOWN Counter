module tb_updown_counter;
reg CLK, RESET, UPDOWN;
wire [2:0] Q;
updown_counter uut(CLK, RESET, UPDOWN, Q);
always #5 CLK = ~CLK;
initial begin
    $monitor("Time=%0t RESET=%b UPDOWN=%b Q=%b",
              $time, RESET, UPDOWN, Q);
   CLK=0;
    RESET=0;
    UPDOWN=1;
  #10 RESET=1;
  // UP counting
    #80;
  // DOWN counting
    UPDOWN=0;
    #80;
 // Reset
    RESET=0;
    #10 RESET=1;

    #30 $finish;
end
endmodule
